# Local development (docker compose up -d postgres)
DATABASE_URL="postgresql://expenses:expenses@localhost:5432/expenses?schema=public"

# E2E tests use a separate database so they never touch real data.
# Defaults to postgresql://expenses:expenses@localhost:5432/expenses_test?schema=public
# TEST_DATABASE_URL="postgresql://expenses:expenses@localhost:5432/expenses_test?schema=public"

# CORS allowlist, comma-separated. Defaults to the production frontends plus
# http://localhost:5174 when unset.
# CORS_ORIGINS="https://expenses.maurihed.com,http://localhost:5174"

# Production (docker-compose.prod.yml).
# The API container connects to the `postgres` service, so DATABASE_URL must use
# the `postgres` hostname and a strong password. Example:
# DATABASE_URL="postgresql://expenses:CHANGE_ME_STRONG@postgres:5432/expenses?schema=public"
POSTGRES_USER=expenses
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=expenses

MONGO_DB_HOST=your-cluster.mongodb.net
MONGO_DB_USERNAME=your-user
MONGO_DB_PASSWORD=your-password
MONGO_DB=expenses
